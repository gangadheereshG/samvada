# ==========================================
# SAMVADA - Environment Configuration
# ==========================================

# Server Environment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Temporary State (Redis)
# If empty or not reachable in development, server automatically activates an in-memory queue fallback
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Persistent Storage (PostgreSQL)
# If empty or not reachable in development, server automatically activates an in-memory audit store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samvada

# WebRTC STUN & TURN Configuration
# Free public STUN servers are used by default
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN server for restrictive firewalls
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
MAX_MESSAGE_LENGTH=1000
